# Copy to .env, or use scripts/configure_deepseek.py. Never put keys in Flutter.
COOK_DEEPSEEK_API_KEY=
COOK_DEEPSEEK_MODEL=deepseek-flash
COOK_DEVELOPMENT_MODE=true
# Anonymous development account is opt-in; normal clients register/login.
COOK_ALLOW_DEVELOPMENT_LOGIN=false
# Required (32+ random characters) when COOK_DEVELOPMENT_MODE=false.
COOK_JWT_SECRET=
# Local SQLite by default; PostgreSQL uses the same ORM/migrations:
# COOK_DATABASE_URL=postgresql+asyncpg://cook:password@localhost:5432/cook
COOK_AI_DAILY_LIMIT=10
COOK_AI_MINUTE_LIMIT=2
COOK_AI_GLOBAL_DAILY_LIMIT=100
COOK_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
